# EditorConfig helps maintain consistent coding styles across different editors and IDEs
# editorconfig.org

root = true

# All files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_size = 2
indent_style = space
end_of_line = lf

# HTML files
[*.html]
indent_size = 2
indent_style = space

# CSS files
[*.css]
indent_size = 2
indent_style = space

# JavaScript files
[*.js]
indent_size = 2
indent_style = space

# JSON files
[*.json]
indent_size = 2
indent_style = space

# Markdown files
[*.md]
trim_trailing_whitespace = false

# YAML files
[*.{yml,yaml}]
indent_size = 2
indent_style = space

# Shell scripts
[*.sh]
indent_size = 2
indent_style = space
